APP_NAME=Smart Alerts AI
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

# --- Data provider (mock | coingecko | binance) ---
DATA_PROVIDER=mock

# --- Coins (CoinGecko IDs) ---
COINS=bitcoin,ethereum,solana,binancecoin,ripple,cardano,dogecoin,polkadot

# --- Detection rules ---
PRICE_CHANGE_PCT=3.0
PRICE_WINDOW_MIN=5
VOLUME_SPIKE_MULTIPLIER=2.0

# --- AI ---
AI_PROVIDER=mock  # mock | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Security ---
INTERNAL_API_KEY=change-me-super-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
