APP_NAME=Smart Alerts AI
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

# --- Data provider (mock | coingecko | binance) ---
DATA_PROVIDER=mock

# --- Coins (CoinGecko IDs) ---
COINS=bitcoin,ethereum,solana,binancecoin,ripple,cardano,dogecoin,polkadot

# --- Detection rules ---
PRICE_CHANGE_PCT=3.0
PRICE_WINDOW_MIN=5
VOLUME_SPIKE_MULTIPLIER=2.0

# --- AI ---
AI_PROVIDER=mock  # mock | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Security ---
INTERNAL_API_KEY=change-me-super-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- No-Cloud-Functions mode (persist + push desde este proceso) ---
# Ruta al service account JSON de Firebase (gratis). Si se omite, el loop
# de generación/outcomes queda desactivado (útil para backtest/dev).
FIREBASE_CREDENTIALS=
# Opcional: si no defines FIREBASE_CREDENTIALS, se usa GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=smartalerts-ae4ec
SIGNAL_SCAN_INTERVAL_S=300     # generar señales cada N segundos
OUTCOME_SCAN_INTERVAL_S=1800   # evaluar outcomes cada N segundos
